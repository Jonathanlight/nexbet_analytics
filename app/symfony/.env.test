# .env.test - Configuration pour l'environnement de test
# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
SYMFONY_DEPRECATIONS_HELPER=999999

###> doctrine/doctrine-bundle ###
# Utiliser MySQL pour les tests (même configuration que dev)
DATABASE_URL="mysql://root:root@mysql:3306/nexbet_analytics?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> Redis Cache ###
# Mock Redis pour les tests - les services seront mockés dans les tests unitaires
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
###< Redis Cache ###

###> Elasticsearch ###
# Mock Elasticsearch pour les tests - les services seront mockés dans les tests unitaires
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
###< Elasticsearch ###

###> External APIs ###
# Clés de test vides - les services seront mockés
THE_ODDS_API_KEY=test_key
FOOTBALL_DATA_API_KEY=test_key
API_FOOTBALL_KEY=test_key
API_BASKETBALL_KEY=test_key
API_HOCKEY_KEY=test_key
OPENWEATHER_API_KEY=test_key
ANTHROPIC_API_KEY=test_key
###< External APIs ###
