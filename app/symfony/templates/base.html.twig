<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}NexBet Analytics{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎯</text></svg>">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}
                {{ importmap('app') }}
            {% endblock %}
        {% endblock %}
    </head>
    <body>
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="{{ path('app_dashboard') }}">🎯 NexBet Analytics</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_dashboard') }}">Tableau de bord</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_football_predictions_today') }}">Football</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_basketball_predictions_today') }}">Basketball</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_betting_combinations') }}">Combinaisons</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_betting_strategies') }}">Stratégies</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container my-4">
            {% block body %}{% endblock %}
        </div>

        <footer class="footer text-center mt-5 py-4">
            <p class="mb-0">&copy; 2026 NexBet Analytics - Analyse de paris sportifs basée sur l'IA</p>
        </footer>
    </body>
</html>
