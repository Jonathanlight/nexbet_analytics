{% extends 'base.html.twig' %}

{% block title %}Analyse {{ match.homeTeam.name }} vs {{ match.awayTeam.name }} - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <a href="{{ path('app_basketball_predictions_today') }}" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left me-1"></i>Retour
        </a>
        <h1 class="h2">
            <i class="fas fa-basketball-ball text-warning me-2"></i>
            Analyse Complete du Match
        </h1>
    </div>
</div>

{# En-tete du match #}
{% if match is defined %}
<div class="card mb-4 border-warning">
    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
        <span class="badge bg-dark">{{ match.league }}</span>
        <span><i class="fas fa-calendar me-1"></i>{{ match.matchDate|date('d/m/Y H:i') }}</span>
    </div>
    <div class="card-body">
        <div class="row text-center align-items-center">
            <div class="col-5">
                <h3 class="mb-1">{{ match.homeTeam.name }}</h3>
            </div>
            <div class="col-2">
                <div class="display-6 text-warning">VS</div>
            </div>
            <div class="col-5">
                <h3 class="mb-1">{{ match.awayTeam.name }}</h3>
            </div>
        </div>
    </div>
</div>
{% endif %}

{# Prediction principale et Total Points #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-chart-pie me-2"></i>Prediction Resultat</div>
            <div class="card-body">
                <div class="row text-center mb-4">
                    <div class="col-6">
                        <div class="display-4 text-success">{{ result_prediction.home_win_prob|default(result_prediction.home_win|default(50))|number_format(0) }}%</div>
                        <div class="fw-bold">{{ match.homeTeam.name }}</div>
                    </div>
                    <div class="col-6">
                        <div class="display-4 text-info">{{ result_prediction.away_win_prob|default(result_prediction.away_win|default(50))|number_format(0) }}%</div>
                        <div class="fw-bold">{{ match.awayTeam.name }}</div>
                    </div>
                </div>
                {% if result_prediction.confidence is defined %}
                <div class="alert alert-{% if result_prediction.confidence >= 70 %}success{% elseif result_prediction.confidence >= 50 %}warning{% else %}secondary{% endif %} text-center">
                    <strong>Confiance:</strong> {{ result_prediction.confidence|number_format(1) }}%
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-calculator me-2"></i>Total Points</div>
            <div class="card-body">
                {% if detailed_analysis.points_analysis is defined %}
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="h4 text-primary">{{ detailed_analysis.points_analysis.home_expected_points|number_format(1) }}</div>
                        <small class="text-muted">Domicile</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-warning">{{ detailed_analysis.points_analysis.total_expected|number_format(1) }}</div>
                        <small class="text-muted">Total Attendu</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-info">{{ detailed_analysis.points_analysis.away_expected_points|number_format(1) }}</div>
                        <small class="text-muted">Exterieur</small>
                    </div>
                </div>
                <h6 class="border-bottom pb-2">Over/Under</h6>
                {% for line, prob in detailed_analysis.points_analysis.over_under_lines %}
                <div class="row mb-1 small">
                    <div class="col-6"><strong>{{ line|replace({'over_': 'Over ', '_5': '.5'}) }}</strong></div>
                    <div class="col-6">
                        <span class="badge {% if prob > 50 %}bg-success{% else %}bg-secondary{% endif %}">
                            {{ prob|number_format(0) }}%
                        </span>
                    </div>
                </div>
                {% endfor %}
                {% else %}
                {% for line, data in total_points %}
                <div class="row mb-2">
                    <div class="col-4"><strong>{{ line }}</strong></div>
                    <div class="col-4">
                        <span class="badge {% if data.over > 50 %}bg-success{% else %}bg-secondary{% endif %}">
                            O: {{ data.over|number_format(0) }}%
                        </span>
                    </div>
                    <div class="col-4">
                        <span class="badge {% if data.under > 50 %}bg-danger{% else %}bg-secondary{% endif %}">
                            U: {{ data.under|number_format(0) }}%
                        </span>
                    </div>
                </div>
                {% endfor %}
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Quart-Temps #}
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="fas fa-clock me-2"></i>Analyse par Quart-Temps</div>
            <div class="card-body">
                {% if detailed_analysis.quarters_analysis is defined %}
                <div class="table-responsive">
                    <table class="table table-sm text-center">
                        <thead class="table-light">
                            <tr>
                                <th>Periode</th>
                                <th>{{ match.homeTeam.name }}</th>
                                <th>{{ match.awayTeam.name }}</th>
                                <th>Total</th>
                                <th>Domicile gagne QT</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for q, data in detailed_analysis.quarters_analysis %}
                                {% if q starts with 'q' %}
                                <tr>
                                    <td><strong>{{ q|upper }}</strong></td>
                                    <td>{{ data.home|number_format(1) }}</td>
                                    <td>{{ data.away|number_format(1) }}</td>
                                    <td>{{ data.total|number_format(1) }}</td>
                                    <td>
                                        <span class="badge {% if data.home_wins_q >= 50 %}bg-success{% else %}bg-secondary{% endif %}">
                                            {{ data.home_wins_q }}%
                                        </span>
                                    </td>
                                </tr>
                                {% endif %}
                            {% endfor %}
                            {% if detailed_analysis.quarters_analysis.halftime is defined %}
                            <tr class="table-warning">
                                <td><strong>Mi-Temps</strong></td>
                                <td>{{ detailed_analysis.quarters_analysis.halftime.home|number_format(1) }}</td>
                                <td>{{ detailed_analysis.quarters_analysis.halftime.away|number_format(1) }}</td>
                                <td>{{ detailed_analysis.quarters_analysis.halftime.total|number_format(1) }}</td>
                                <td>-</td>
                            </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="row">
                    {% for quarter, data in quarters %}
                    <div class="col-md-3 mb-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h6>{{ quarter }}</h6>
                                <div class="row">
                                    <div class="col-6">
                                        <div class="h5 text-primary">{{ data.home_points|number_format(1) }}</div>
                                        <small>Dom.</small>
                                    </div>
                                    <div class="col-6">
                                        <div class="h5 text-info">{{ data.away_points|number_format(1) }}</div>
                                        <small>Ext.</small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Handicaps et Meilleurs Marqueurs #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-balance-scale me-2"></i>Handicaps</div>
            <div class="card-body">
                {% for handicap, data in handicap_prediction %}
                <div class="row mb-2 align-items-center">
                    <div class="col-4"><strong>{{ handicap }}</strong></div>
                    <div class="col-8">
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Dom: {{ data.home|number_format(1) }}%</span>
                            <span>Ext: {{ data.away|number_format(1) }}%</span>
                        </div>
                        <div class="progress" style="height: 20px;">
                            <div class="progress-bar {% if data.home >= 55 %}bg-success{% elseif data.home >= 45 %}bg-warning{% else %}bg-danger{% endif %}"
                                 style="width: {{ data.home }}%">
                                {{ data.home|number_format(0) }}%
                            </div>
                            <div class="progress-bar {% if data.away >= 55 %}bg-info{% elseif data.away >= 45 %}bg-secondary{% else %}bg-light text-dark{% endif %}"
                                 style="width: {{ data.away }}%">
                                {{ data.away|number_format(0) }}%
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-star me-2"></i>Meilleurs Marqueurs Attendus</div>
            <div class="card-body">
                {% if detailed_analysis.scoring_leaders is defined %}
                <div class="row">
                    <div class="col-6">
                        <h6>{{ match.homeTeam.name }}</h6>
                        <ul class="list-unstyled small">
                            {% for scorer in detailed_analysis.scoring_leaders.home_top_scorers %}
                            <li class="mb-1">
                                <strong>{{ scorer.name }}</strong>
                                <span class="badge bg-primary">{{ scorer.expected_points|number_format(1) }} pts</span>
                                <small class="text-muted">+20pts: {{ scorer.prob_20_plus }}%</small>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="col-6">
                        <h6>{{ match.awayTeam.name }}</h6>
                        <ul class="list-unstyled small">
                            {% for scorer in detailed_analysis.scoring_leaders.away_top_scorers %}
                            <li class="mb-1">
                                <strong>{{ scorer.name }}</strong>
                                <span class="badge bg-info">{{ scorer.expected_points|number_format(1) }} pts</span>
                                <small class="text-muted">+20pts: {{ scorer.prob_20_plus }}%</small>
                            </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                {% else %}
                <p class="text-muted">Donnees des marqueurs non disponibles</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Stats Equipes et Tirs a 3 Points #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-chart-bar me-2"></i>Statistiques Equipes</div>
            <div class="card-body">
                {% if detailed_analysis.team_stats is defined %}
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th></th>
                                <th class="text-center">{{ match.homeTeam.name|slice(0,10) }}</th>
                                <th class="text-center">{{ match.awayTeam.name|slice(0,10) }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Moy. Points</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.home.avg_points|number_format(1) }}</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.away.avg_points|number_format(1) }}</td>
                            </tr>
                            <tr>
                                <td>Moy. Rebonds</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.home.avg_rebounds|number_format(1) }}</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.away.avg_rebounds|number_format(1) }}</td>
                            </tr>
                            <tr>
                                <td>Moy. Passes</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.home.avg_assists|number_format(1) }}</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.away.avg_assists|number_format(1) }}</td>
                            </tr>
                            <tr>
                                <td>% Tir</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.home.fg_percentage|number_format(1) }}%</td>
                                <td class="text-center">{{ detailed_analysis.team_stats.away.fg_percentage|number_format(1) }}%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-crosshairs me-2"></i>Tirs a 3 Points</div>
            <div class="card-body">
                {% if detailed_analysis.three_point_analysis is defined %}
                <div class="row text-center mb-3">
                    <div class="col-6">
                        <h6>{{ match.homeTeam.name }}</h6>
                        <div class="h4 text-primary">{{ detailed_analysis.three_point_analysis.home.made_per_game|number_format(1) }}</div>
                        <small class="text-muted">3pts/match ({{ detailed_analysis.three_point_analysis.home.percentage|number_format(1) }}%)</small>
                    </div>
                    <div class="col-6">
                        <h6>{{ match.awayTeam.name }}</h6>
                        <div class="h4 text-info">{{ detailed_analysis.three_point_analysis.away.made_per_game|number_format(1) }}</div>
                        <small class="text-muted">3pts/match ({{ detailed_analysis.three_point_analysis.away.percentage|number_format(1) }}%)</small>
                    </div>
                </div>
                <div class="alert alert-secondary text-center mb-0">
                    <strong>Combined 3pts attendus:</strong> {{ detailed_analysis.three_point_analysis.combined_threes_expected|number_format(1) }}
                    <br>
                    <small>Over 23.5: {{ detailed_analysis.three_point_analysis.over_23_5_combined }}%</small>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Rythme et Defense #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-running me-2"></i>Rythme de Jeu (Pace)</div>
            <div class="card-body">
                {% if detailed_analysis.pace_analysis is defined %}
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="h5">{{ detailed_analysis.pace_analysis.home_pace|number_format(1) }}</div>
                        <small>Domicile</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-warning">{{ detailed_analysis.pace_analysis.expected_pace|number_format(1) }}</div>
                        <small>Attendu</small>
                    </div>
                    <div class="col-4">
                        <div class="h5">{{ detailed_analysis.pace_analysis.away_pace|number_format(1) }}</div>
                        <small>Exterieur</small>
                    </div>
                </div>
                <div class="alert alert-info text-center mb-0">
                    <span class="badge bg-{% if detailed_analysis.pace_analysis.pace_rating == 'Rapide' %}success{% elseif detailed_analysis.pace_analysis.pace_rating == 'Lent' %}danger{% else %}warning{% endif %}">
                        {{ detailed_analysis.pace_analysis.pace_rating }}
                    </span>
                    <div class="small mt-1">{{ detailed_analysis.pace_analysis.impact }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-shield-alt me-2"></i>Analyse Defensive</div>
            <div class="card-body">
                {% if detailed_analysis.defensive_analysis is defined %}
                <div class="row">
                    <div class="col-6">
                        <h6>{{ match.homeTeam.name }}</h6>
                        <div class="mb-2">
                            <span class="badge bg-{% if detailed_analysis.defensive_analysis.home.rating == 'Elite' %}success{% elseif detailed_analysis.defensive_analysis.home.rating == 'Bonne' %}primary{% else %}warning{% endif %}">
                                {{ detailed_analysis.defensive_analysis.home.rating }}
                            </span>
                        </div>
                        <small>Rating: {{ detailed_analysis.defensive_analysis.home.defensive_rating }}</small><br>
                        <small>Points accordes: {{ detailed_analysis.defensive_analysis.home.points_allowed }}</small>
                    </div>
                    <div class="col-6">
                        <h6>{{ match.awayTeam.name }}</h6>
                        <div class="mb-2">
                            <span class="badge bg-{% if detailed_analysis.defensive_analysis.away.rating == 'Elite' %}success{% elseif detailed_analysis.defensive_analysis.away.rating == 'Bonne' %}primary{% else %}warning{% endif %}">
                                {{ detailed_analysis.defensive_analysis.away.rating }}
                            </span>
                        </div>
                        <small>Rating: {{ detailed_analysis.defensive_analysis.away.defensive_rating }}</small><br>
                        <small>Points accordes: {{ detailed_analysis.defensive_analysis.away.points_allowed }}</small>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Forme et Confrontations #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-chart-line me-2"></i>Forme Recente</div>
            <div class="card-body">
                {% if detailed_analysis.form_analysis is defined %}
                <div class="row">
                    <div class="col-6">
                        <h6>{{ match.homeTeam.name }}</h6>
                        <div class="mb-2">
                            {% for char in detailed_analysis.form_analysis.home.last_5|split('') %}
                            <span class="badge {% if char == 'W' %}bg-success{% else %}bg-danger{% endif %}">{{ char }}</span>
                            {% endfor %}
                        </div>
                        <small class="text-muted">
                            {{ detailed_analysis.form_analysis.home.wins_last_10 }}/10 victoires<br>
                            Domicile: {{ detailed_analysis.form_analysis.home.home_record }}
                        </small>
                    </div>
                    <div class="col-6">
                        <h6>{{ match.awayTeam.name }}</h6>
                        <div class="mb-2">
                            {% for char in detailed_analysis.form_analysis.away.last_5|split('') %}
                            <span class="badge {% if char == 'W' %}bg-success{% else %}bg-danger{% endif %}">{{ char }}</span>
                            {% endfor %}
                        </div>
                        <small class="text-muted">
                            {{ detailed_analysis.form_analysis.away.wins_last_10 }}/10 victoires<br>
                            Exterieur: {{ detailed_analysis.form_analysis.away.away_record }}
                        </small>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-history me-2"></i>Confrontations Directes</div>
            <div class="card-body">
                {% if detailed_analysis.head_to_head is defined %}
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="h4 text-success">{{ detailed_analysis.head_to_head.home_wins }}</div>
                        <small>{{ match.homeTeam.name|slice(0,10) }}</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-secondary">{{ detailed_analysis.head_to_head.matches_played }}</div>
                        <small>Matchs</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-info">{{ detailed_analysis.head_to_head.away_wins }}</div>
                        <small>{{ match.awayTeam.name|slice(0,10) }}</small>
                    </div>
                </div>
                <div class="small text-muted text-center">
                    Moy. points total: {{ detailed_analysis.head_to_head.avg_total_points|number_format(1) }}<br>
                    Marge moyenne: {{ detailed_analysis.head_to_head.avg_margin|number_format(1) }} pts
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Double-Double et Triple-Double Candidates #}
{% if detailed_analysis.scoring_leaders.double_double_candidates is defined %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="fas fa-award me-2"></i>Candidats Double-Double / Triple-Double</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <h6>Double-Double</h6>
                        {% for candidate in detailed_analysis.scoring_leaders.double_double_candidates %}
                        <span class="badge bg-success me-2 mb-2">
                            {{ candidate.name }}: {{ candidate.probability }}%
                        </span>
                        {% endfor %}
                    </div>
                    <div class="col-md-6">
                        <h6>Triple-Double</h6>
                        {% for candidate in detailed_analysis.scoring_leaders.triple_double_candidates %}
                        <span class="badge bg-warning text-dark me-2 mb-2">
                            {{ candidate.name }}: {{ candidate.probability }}%
                        </span>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{# Indicateurs de Valeur #}
{% if detailed_analysis.value_indicators is defined %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="fas fa-gem me-2"></i>Indicateurs de Valeur</div>
            <div class="card-body">
                <div class="row">
                    {% for market, data in detailed_analysis.value_indicators %}
                    <div class="col-md-4 mb-3">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h6>{{ market|replace({'_': ' '})|title }}</h6>
                                <div class="h4">{{ data.probability|number_format(1) }}%</div>
                                {% if data.fair_odds is defined %}
                                    <small class="text-muted">Cote juste: {{ data.fair_odds|number_format(2) }}</small>
                                {% elseif data.line is defined %}
                                    <small class="text-muted">Ligne: {{ data.line }}</small>
                                {% endif %}
                                {% if data.is_value is defined and data.is_value %}<span class="badge bg-success ms-1">Value</span>{% endif %}
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}