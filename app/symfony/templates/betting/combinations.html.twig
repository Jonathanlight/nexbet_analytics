{% extends 'base.html.twig' %}

{% block title %}Combinaisons de Paris - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1 class="h2 mb-3">💰 Générateur de Combinaisons</h1>
        <p class="text-muted">Créez des combinaisons optimales de paris</p>
    </div>
</div>

<div class="alert alert-info">
    <h5 class="alert-heading">Fonctionnalité en développement</h5>
    <p class="mb-0">Le générateur de combinaisons sera disponible prochainement. Il vous permettra de créer des systèmes comme Trixie, Patent, Yankee avec calcul automatique des gains potentiels.</p>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">Trixie</div>
            <div class="card-body">
                <p class="small">3 sélections → 4 paris</p>
                <ul class="small">
                    <li>3 doubles</li>
                    <li>1 triple</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">Patent</div>
            <div class="card-body">
                <p class="small">3 sélections → 7 paris</p>
                <ul class="small">
                    <li>3 simples</li>
                    <li>3 doubles</li>
                    <li>1 triple</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card">
            <div class="card-header">Yankee</div>
            <div class="card-body">
                <p class="small">4 sélections → 11 paris</p>
                <ul class="small">
                    <li>6 doubles</li>
                    <li>4 triples</li>
                    <li>1 quadruple</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
