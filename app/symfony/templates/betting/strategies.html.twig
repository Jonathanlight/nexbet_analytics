{% extends 'base.html.twig' %}

{% block title %}{{ 'betting.strategies'|trans }} - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1 class="h2 mb-3">📊 {{ 'betting.strategies_title'|trans }}</h1>
        <p class="text-muted">{{ 'betting.strategies_description'|trans }}</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">{{ 'profile.conservative'|trans }}</h5>
            </div>
            <div class="card-body">
                <h6>{{ 'betting.kelly_criterion'|trans }}: 25%</h6>
                <p class="small">{{ 'betting.recommended_stake'|trans }}: 1% {{ 'betting.bankroll'|trans|lower }}</p>
                <ul class="small">
                    <li>{{ 'betting.min_confidence'|trans }}: 80%</li>
                    <li>{{ 'betting.expected_value'|trans }}: &gt; 5%</li>
                    <li>{{ 'betting.focus_safe_bets'|trans }}</li>
                </ul>
                <div class="alert alert-success small">
                    {{ 'betting.minimal_risk'|trans }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header bg-warning">
                <h5 class="mb-0">{{ 'profile.balanced'|trans }}</h5>
            </div>
            <div class="card-body">
                <h6>{{ 'betting.kelly_criterion'|trans }}: 50%</h6>
                <p class="small">{{ 'betting.recommended_stake'|trans }}: 1-4% {{ 'betting.bankroll'|trans|lower }}</p>
                <ul class="small">
                    <li>{{ 'betting.min_confidence'|trans }}: 65%</li>
                    <li>{{ 'betting.expected_value'|trans }}: &gt; 3%</li>
                    <li>{{ 'betting.mix_safe_value'|trans }}</li>
                </ul>
                <div class="alert alert-warning small">
                    {{ 'betting.moderate_risk'|trans }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">{{ 'profile.aggressive'|trans }}</h5>
            </div>
            <div class="card-body">
                <h6>{{ 'betting.kelly_criterion'|trans }}: 75%</h6>
                <p class="small">{{ 'betting.recommended_stake'|trans }}: 2-7% {{ 'betting.bankroll'|trans|lower }}</p>
                <ul class="small">
                    <li>{{ 'betting.min_confidence'|trans }}: 55%</li>
                    <li>{{ 'betting.expected_value'|trans }}: &gt; 2%</li>
                    <li>{{ 'betting.all_value_bets'|trans }}</li>
                </ul>
                <div class="alert alert-danger small">
                    {{ 'betting.high_risk'|trans }}
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">{{ 'betting.kelly_criterion'|trans }}</h5>
    </div>
    <div class="card-body">
        <p>{{ 'betting.kelly_description'|trans }}</p>
        <p class="mb-0"><strong>{{ 'betting.kelly_formula'|trans }}:</strong> f* = (bp - q) / b</p>
        <ul class="small">
            <li>f* = {{ 'betting.kelly_f'|trans }}</li>
            <li>b = {{ 'betting.kelly_b'|trans }}</li>
            <li>p = {{ 'betting.kelly_p'|trans }}</li>
            <li>q = {{ 'betting.kelly_q'|trans }}</li>
        </ul>
    </div>
</div>
{% endblock %}
