{% extends 'base.html.twig' %}

{% block title %}Analyse {{ match.homeTeam.name }} vs {{ match.awayTeam.name }} - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <a href="{{ path('app_football_predictions_today') }}" class="btn btn-outline-secondary btn-sm mb-3">
            <i class="fas fa-arrow-left me-1"></i>Retour
        </a>
        <h1 class="h2">
            <i class="fas fa-futbol text-primary me-2"></i>
            Analyse Complete du Match
        </h1>
    </div>
</div>

{# En-tete du match #}
<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span class="badge bg-light text-primary">{{ match.league }}</span>
        <span><i class="fas fa-calendar me-1"></i>{{ match.matchDate|date('d/m/Y H:i') }}</span>
    </div>
    <div class="card-body">
        <div class="row text-center align-items-center">
            <div class="col-5">
                <h3 class="mb-1">{{ match.homeTeam.name }}</h3>
                <small class="text-muted">ELO: {{ match.homeTeam.eloRating|number_format(0) }}</small>
            </div>
            <div class="col-2">
                <div class="display-6 text-primary">VS</div>
            </div>
            <div class="col-5">
                <h3 class="mb-1">{{ match.awayTeam.name }}</h3>
                <small class="text-muted">ELO: {{ match.awayTeam.eloRating|number_format(0) }}</small>
            </div>
        </div>
    </div>
</div>

{# Prediction principale #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-chart-pie me-2"></i>Prediction 1X2</div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Victoire Domicile (1)</span>
                        <strong class="{% if result_prediction.prediction == '1' %}text-success{% endif %}">
                            {{ result_prediction.probabilities['1']|number_format(1) }}%
                        </strong>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-success" style="width: {{ result_prediction.probabilities['1'] }}%">
                            {{ result_prediction.probabilities['1']|number_format(0) }}%
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Match Nul (X)</span>
                        <strong class="{% if result_prediction.prediction == 'X' %}text-success{% endif %}">
                            {{ result_prediction.probabilities['X']|number_format(1) }}%
                        </strong>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-warning" style="width: {{ result_prediction.probabilities['X'] }}%">
                            {{ result_prediction.probabilities['X']|number_format(0) }}%
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <span>Victoire Exterieur (2)</span>
                        <strong class="{% if result_prediction.prediction == '2' %}text-success{% endif %}">
                            {{ result_prediction.probabilities['2']|number_format(1) }}%
                        </strong>
                    </div>
                    <div class="progress" style="height: 20px;">
                        <div class="progress-bar bg-info" style="width: {{ result_prediction.probabilities['2'] }}%">
                            {{ result_prediction.probabilities['2']|number_format(0) }}%
                        </div>
                    </div>
                </div>

                <div class="alert alert-{% if result_prediction.confidence >= 70 %}success{% elseif result_prediction.confidence >= 50 %}warning{% else %}secondary{% endif %} mb-0">
                    <div class="row">
                        <div class="col-6">
                            <strong>Prediction:</strong>
                            <span class="badge bg-primary fs-5">{{ result_prediction.prediction }}</span>
                        </div>
                        <div class="col-6 text-end">
                            <strong>Confiance:</strong> {{ result_prediction.confidence|number_format(1) }}%
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-futbol me-2"></i>Analyse des Buts</div>
            <div class="card-body">
                {% if detailed_analysis.goals_analysis is defined %}
                <div class="row mb-3">
                    <div class="col-4 text-center">
                        <div class="h4 text-primary">{{ detailed_analysis.goals_analysis.home_expected_goals|number_format(2) }}</div>
                        <small class="text-muted">Buts Domicile</small>
                    </div>
                    <div class="col-4 text-center">
                        <div class="h4 text-warning">{{ detailed_analysis.goals_analysis.total_expected_goals|number_format(2) }}</div>
                        <small class="text-muted">Total Attendu</small>
                    </div>
                    <div class="col-4 text-center">
                        <div class="h4 text-info">{{ detailed_analysis.goals_analysis.away_expected_goals|number_format(2) }}</div>
                        <small class="text-muted">Buts Exterieur</small>
                    </div>
                </div>
                {% endif %}

                <h6 class="border-bottom pb-2">Over/Under</h6>
                {% for line, prediction in goals_prediction %}
                <div class="row mb-1 small">
                    <div class="col-4"><strong>{{ line }}</strong></div>
                    <div class="col-4">
                        <span class="badge {% if prediction.over > 50 %}bg-success{% else %}bg-secondary{% endif %}">
                            O: {{ prediction.over|number_format(0) }}%
                        </span>
                    </div>
                    <div class="col-4">
                        <span class="badge {% if prediction.under > 50 %}bg-danger{% else %}bg-secondary{% endif %}">
                            U: {{ prediction.under|number_format(0) }}%
                        </span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

{# BTTS et Score Exact #}
<div class="row mb-4">
    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-check-double me-2"></i>BTTS</div>
            <div class="card-body text-center">
                <div class="row">
                    <div class="col-6">
                        <div class="display-6 text-success">{{ btts_prediction.yes|number_format(0) }}%</div>
                        <div class="fw-bold">Oui</div>
                    </div>
                    <div class="col-6">
                        <div class="display-6 text-danger">{{ btts_prediction.no|number_format(0) }}%</div>
                        <div class="fw-bold">Non</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-bullseye me-2"></i>Score Exact</div>
            <div class="card-body">
                <div class="alert alert-primary text-center mb-2">
                    <strong class="fs-4">{{ exact_score.most_likely }}</strong>
                    <div class="small">{{ exact_score.probability|number_format(1) }}%</div>
                </div>
                <div class="small">
                    <strong>Autres scores probables:</strong>
                    <ul class="mb-0 mt-1">
                        {% for score, prob in exact_score.top_scores|slice(1, 4) %}
                        <li>{{ score }}: {{ prob|number_format(1) }}%</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-clock me-2"></i>Mi-Temps</div>
            <div class="card-body">
                {% if detailed_analysis.halftime_analysis is defined %}
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="h5">{{ detailed_analysis.halftime_analysis.ht_result['1']|number_format(0) }}%</div>
                        <small>1</small>
                    </div>
                    <div class="col-4">
                        <div class="h5">{{ detailed_analysis.halftime_analysis.ht_result['X']|number_format(0) }}%</div>
                        <small>X</small>
                    </div>
                    <div class="col-4">
                        <div class="h5">{{ detailed_analysis.halftime_analysis.ht_result['2']|number_format(0) }}%</div>
                        <small>2</small>
                    </div>
                </div>
                <div class="small">
                    <strong>Buts attendus MT:</strong> {{ detailed_analysis.halftime_analysis.total_expected_ht|number_format(2) }}
                    <br>
                    <strong>Over 0.5 MT:</strong> {{ detailed_analysis.halftime_analysis.over_0_5_ht|number_format(0) }}%
                </div>
                {% else %}
                <p class="text-muted">Donnees mi-temps non disponibles</p>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Stabilite et Contexte #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-balance-scale me-2"></i>Stabilite des Equipes</div>
            <div class="card-body">
                {% if detailed_analysis.team_stability is defined %}
                <div class="row">
                    <div class="col-6">
                        <h6 class="text-center">{{ match.homeTeam.name }}</h6>
                        <div class="text-center mb-2">
                            <div class="display-6 text-primary">{{ detailed_analysis.team_stability.home.stability_score }}</div>
                            <span class="badge bg-{% if detailed_analysis.team_stability.home.stability_score >= 70 %}success{% elseif detailed_analysis.team_stability.home.stability_score >= 50 %}warning{% else %}danger{% endif %}">
                                {{ detailed_analysis.team_stability.home.rating }}
                            </span>
                        </div>
                    </div>
                    <div class="col-6">
                        <h6 class="text-center">{{ match.awayTeam.name }}</h6>
                        <div class="text-center mb-2">
                            <div class="display-6 text-info">{{ detailed_analysis.team_stability.away.stability_score }}</div>
                            <span class="badge bg-{% if detailed_analysis.team_stability.away.stability_score >= 70 %}success{% elseif detailed_analysis.team_stability.away.stability_score >= 50 %}warning{% else %}danger{% endif %}">
                                {{ detailed_analysis.team_stability.away.rating }}
                            </span>
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-trophy me-2"></i>Importance du Match</div>
            <div class="card-body">
                {% if detailed_analysis.match_importance is defined %}
                <div class="row mb-3">
                    <div class="col-6">
                        <strong>Score d'importance:</strong>
                    </div>
                    <div class="col-6 text-end">
                        <span class="badge bg-{% if detailed_analysis.match_importance.importance_score >= 80 %}danger{% elseif detailed_analysis.match_importance.importance_score >= 60 %}warning{% else %}secondary{% endif %} fs-6">
                            {{ detailed_analysis.match_importance.importance_score }}/100
                        </span>
                    </div>
                </div>
                <ul class="list-unstyled small mb-0">
                    <li><i class="fas fa-flag me-2"></i>Derby: {{ detailed_analysis.match_importance.is_derby ? 'Oui' : 'Non' }}</li>
                    <li><i class="fas fa-star me-2"></i>Enjeux titre: {{ detailed_analysis.match_importance.title_implications }}</li>
                    <li><i class="fas fa-fire me-2"></i>Motivation domicile: {{ detailed_analysis.match_importance.motivation_factor.home }}%</li>
                    <li><i class="fas fa-fire me-2"></i>Motivation exterieur: {{ detailed_analysis.match_importance.motivation_factor.away }}%</li>
                </ul>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Arbitre et Meteo #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-user-tie me-2"></i>Analyse Arbitre</div>
            <div class="card-body">
                {% if detailed_analysis.referee_analysis is defined %}
                <div class="row small">
                    <div class="col-6">
                        <ul class="list-unstyled mb-0">
                            <li><strong>Arbitre:</strong> {{ detailed_analysis.referee_analysis.name }}</li>
                            <li><strong>Moy. cartons jaunes:</strong> {{ detailed_analysis.referee_analysis.avg_yellow_cards }}</li>
                            <li><strong>Moy. cartons rouges:</strong> {{ detailed_analysis.referee_analysis.avg_red_cards }}</li>
                        </ul>
                    </div>
                    <div class="col-6">
                        <ul class="list-unstyled mb-0">
                            <li><strong>Taux penalty:</strong> {{ detailed_analysis.referee_analysis.penalty_rate }}</li>
                            <li><strong>Severite:</strong> {{ detailed_analysis.referee_analysis.strictness }}</li>
                            <li><strong>Biais domicile:</strong> {{ detailed_analysis.referee_analysis.home_bias.score }}%</li>
                        </ul>
                    </div>
                </div>
                <div class="mt-2">
                    <strong>Prediction cartons:</strong>
                    <span class="badge bg-warning text-dark">+3.5: {{ detailed_analysis.referee_analysis.cards_prediction.over_3_5_cards }}%</span>
                    <span class="badge bg-danger">+4.5: {{ detailed_analysis.referee_analysis.cards_prediction.over_4_5_cards }}%</span>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-cloud-sun me-2"></i>Conditions Meteo</div>
            <div class="card-body">
                {% if detailed_analysis.weather_conditions is defined %}
                <div class="row text-center">
                    <div class="col-3">
                        <div class="h4"><i class="fas fa-thermometer-half"></i></div>
                        <div>{{ detailed_analysis.weather_conditions.temperature }}°C</div>
                    </div>
                    <div class="col-3">
                        <div class="h4"><i class="fas fa-wind"></i></div>
                        <div>{{ detailed_analysis.weather_conditions.wind_speed }} km/h</div>
                    </div>
                    <div class="col-3">
                        <div class="h4"><i class="fas fa-tint"></i></div>
                        <div>{{ detailed_analysis.weather_conditions.humidity }}%</div>
                    </div>
                    <div class="col-3">
                        <div class="h4"><i class="fas fa-cloud-rain"></i></div>
                        <div>{{ detailed_analysis.weather_conditions.precipitation }}%</div>
                    </div>
                </div>
                <div class="mt-3 text-center">
                    <span class="badge bg-info">{{ detailed_analysis.weather_conditions.condition }}</span>
                    <div class="small text-muted mt-1">Impact: {{ detailed_analysis.weather_conditions.impact_on_play }}</div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Confrontations et Forme #}
<div class="row mb-4">
    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-history me-2"></i>Confrontations Directes</div>
            <div class="card-body">
                {% if h2h is defined and h2h.matches_played is defined %}
                <div class="row text-center mb-3">
                    <div class="col-4">
                        <div class="h4 text-success">{{ h2h.home_wins|default(0) }}</div>
                        <small>{{ match.homeTeam.name|slice(0,10) }}</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-secondary">{{ h2h.draws|default(0) }}</div>
                        <small>Nuls</small>
                    </div>
                    <div class="col-4">
                        <div class="h4 text-info">{{ h2h.away_wins|default(0) }}</div>
                        <small>{{ match.awayTeam.name|slice(0,10) }}</small>
                    </div>
                </div>
                <div class="small text-muted text-center">
                    {{ h2h.matches_played|default(0) }} confrontations - Moy. {{ h2h.avg_goals|default(2.5) }} buts/match
                </div>
                {% else %}
                <p class="text-muted">Pas de confrontations recentes</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="card h-100">
            <div class="card-header"><i class="fas fa-chart-line me-2"></i>Forme Recente</div>
            <div class="card-body">
                {% if detailed_analysis.form_analysis is defined %}
                <div class="row">
                    <div class="col-6">
                        <h6>{{ match.homeTeam.name }}</h6>
                        <div class="mb-2">
                            {% for char in detailed_analysis.form_analysis.home.last_5|split('') %}
                            <span class="badge {% if char == 'W' %}bg-success{% elseif char == 'D' %}bg-warning{% else %}bg-danger{% endif %}">{{ char }}</span>
                            {% endfor %}
                        </div>
                        <small class="text-muted">
                            {{ detailed_analysis.form_analysis.home.points_last_5 }} pts -
                            {{ detailed_analysis.form_analysis.home.goals_scored_last_5 }} buts
                        </small>
                    </div>
                    <div class="col-6">
                        <h6>{{ match.awayTeam.name }}</h6>
                        <div class="mb-2">
                            {% for char in detailed_analysis.form_analysis.away.last_5|split('') %}
                            <span class="badge {% if char == 'W' %}bg-success{% elseif char == 'D' %}bg-warning{% else %}bg-danger{% endif %}">{{ char }}</span>
                            {% endfor %}
                        </div>
                        <small class="text-muted">
                            {{ detailed_analysis.form_analysis.away.points_last_5 }} pts -
                            {{ detailed_analysis.form_analysis.away.goals_scored_last_5 }} buts
                        </small>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Indicateurs de Valeur #}
{% if detailed_analysis.value_indicators is defined %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header"><i class="fas fa-gem me-2"></i>Indicateurs de Valeur</div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Marche</th>
                                <th class="text-center">Probabilite</th>
                                <th class="text-center">Cote</th>
                                <th class="text-center">Valeur Attendue</th>
                                <th class="text-center">Value Bet?</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for market, data in detailed_analysis.value_indicators %}
                            <tr>
                                <td><strong>{{ market }}</strong></td>
                                <td class="text-center">{{ data.probability|number_format(1) }}%</td>
                                <td class="text-center">{{ data.odds|number_format(2) }}</td>
                                <td class="text-center {% if data.expected_value > 0 %}text-success{% else %}text-danger{% endif %}">
                                    {{ data.expected_value|number_format(3) }}
                                </td>
                                <td class="text-center">
                                    {% if data.is_value %}
                                    <span class="badge bg-success"><i class="fas fa-check"></i> OUI</span>
                                    {% else %}
                                    <span class="badge bg-secondary">NON</span>
                                    {% endif %}
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}

{# Recherche IA #}
{% if ai_research is defined and ai_research.analysis is defined %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-info">
            <div class="card-header bg-info text-white">
                <i class="fas fa-robot me-2"></i>Analyse IA
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <h6>Facteurs Cles</h6>
                        <ul class="small">
                            {% for factor in ai_research.key_factors|default([]) %}
                            <li>{{ factor }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                    <div class="col-md-6 mb-3">
                        <h6>Niveau de Risque</h6>
                        <div class="h4">
                            <span class="badge bg-{% if ai_research.risk_level|default('medium') == 'low' %}success{% elseif ai_research.risk_level|default('medium') == 'high' %}danger{% else %}warning{% endif %}">
                                {{ ai_research.risk_level|default('Moyen')|capitalize }}
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endif %}
{% endblock %}