{% extends 'base.html.twig' %}

{% block title %}Paris Sûrs Football - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1 class="h2 mb-3">🛡️ Paris Sûrs Football</h1>
        <p class="text-muted">Matchs avec haute confiance (&gt; 85%)</p>
    </div>
</div>

{% if safe_bets is empty %}
<div class="alert alert-warning">
    <h4 class="alert-heading">Aucun pari sûr aujourd'hui</h4>
    <p class="mb-0">Aucun match ne répond aux critères de paris sûrs aujourd'hui (confiance &gt; 85%).</p>
</div>
{% else %}
<div class="row">
    {% for bet in safe_bets %}
    <div class="col-lg-4 mb-4">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white">
                <strong>{{ bet.match.league }}</strong>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <h5>{{ bet.match.homeTeam.name }} vs {{ bet.match.awayTeam.name }}</h5>
                    <small class="text-muted">{{ bet.match.matchDate|date('d/m/Y H:i') }}</small>
                </div>

                <div class="alert alert-success">
                    <strong>Prédiction: {{ bet.predictions.most_likely }}</strong>
                    <div>Confiance: {{ bet.predictions.confidence|number_format(1) }}%</div>
                </div>

                <a href="{{ path('app_football_match_analysis', {id: bet.match.id}) }}" class="btn btn-success btn-sm w-100">
                    Analyse détaillée
                </a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
