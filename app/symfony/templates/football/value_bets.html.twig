{% extends 'base.html.twig' %}

{% block title %}{{ 'football.value_bets_title'|trans }} - NexBet Analytics{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col">
        <h1 class="h2 mb-3">💎 {{ 'football.value_bets_title'|trans }}</h1>
        <p class="text-muted">{{ 'football.positive_edge'|trans }}</p>
    </div>
</div>

{% if value_bets is empty %}
<div class="alert alert-info">
    <h4 class="alert-heading">{{ 'football.no_value_bets_detected'|trans }}</h4>
    <p class="mb-0">{{ 'football.no_value_bets_message'|trans }}</p>
</div>
{% else %}
<div class="row">
    {% for vb in value_bets %}
    <div class="col-lg-6 mb-4">
        <div class="card h-100 border-warning">
            <div class="card-header bg-warning">
                <strong>{{ vb.match.league }}</strong>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <h5>{{ vb.match.homeTeam.name }} {{ 'match.vs'|trans|lower }} {{ vb.match.awayTeam.name }}</h5>
                    <small class="text-muted">{{ vb.match.matchDate|date('d/m/Y H:i') }}</small>
                </div>

                {% for bet in vb.value_bets %}
                <div class="mb-3 p-2 bg-light rounded">
                    <div class="d-flex justify-content-between">
                        <strong>{{ bet.bet_type }}</strong>
                        <span class="badge bg-success">{{ 'football.edge'|trans }}: +{{ bet.edge }}%</span>
                    </div>
                    <div class="small">
                        {{ 'prediction.probability'|trans }}: {{ bet.probability|number_format(1) }}%<br>
                        {{ 'betting.expected_value'|trans }}: {{ bet.expected_value|number_format(2) }}
                    </div>
                </div>
                {% endfor %}

                <a href="{{ path('app_football_match_analysis', {id: vb.match.id}) }}" class="btn btn-warning btn-sm w-100">
                    {{ 'football.detailed_analysis'|trans }}
                </a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>
{% endif %}
{% endblock %}
