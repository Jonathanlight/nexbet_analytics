{% extends 'base.html.twig' %}

{% block title %}Predictions Hockey du Jour - NexBet Analytics{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark border-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h1 class="h3 mb-0 text-info">
                                <i class="fas fa-hockey-puck me-2"></i>Predictions Hockey du Jour
                            </h1>
                            <p class="text-muted mb-0">Matchs de hockey sur glace avec analyses et predictions IA</p>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-info fs-5">{{ total_count }} matchs a venir</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% if matches_with_predictions is empty %}
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark">
                <div class="card-body text-center py-5">
                    <i class="fas fa-hockey-puck fa-4x text-muted mb-3"></i>
                    <h4 class="text-muted">Aucun match aujourd'hui</h4>
                    <p class="text-muted">Il n'y a pas de matchs programmes pour aujourd'hui. Revenez plus tard !</p>
                    <a href="{{ path('app_hockey_predictions_today') }}" class="btn btn-info mt-3">
                        <i class="fas fa-sync me-2"></i>Actualiser
                    </a>
                </div>
            </div>
        </div>
    </div>
    {% else %}
    <div class="row">
        {% for item in matches_with_predictions %}
        {% set match = item.match %}
        {% set prediction = item.prediction %}
        {% set total_goals = item.total_goals %}
        <div class="col-lg-6 col-xl-4 mb-4">
            <div class="card bg-light h-100 border-secondary hover-card">
                <div class="card-header bg-secondary bg-opacity-25 d-flex justify-content-between align-items-center">
                    <span class="badge bg-info">{{ match.league }}</span>
                    <span class="text-muted small">
                        <i class="far fa-clock me-1"></i>{{ match.matchDate|date('H:i') }}
                    </span>
                </div>

                <div class="card-body">
                    <div class="row align-items-center mb-3">
                        <div class="col-5 text-center">
                            <div class="fw-bold text-dark">{{ match.homeTeam.name }}</div>
                            <small class="text-muted">Domicile</small>
                        </div>
                        <div class="col-2 text-center">
                            <span class="badge bg-dark border border-info fs-6">VS</span>
                        </div>
                        <div class="col-5 text-center">
                            <div class="fw-bold text-dark">{{ match.awayTeam.name }}</div>
                            <small class="text-muted">Exterieur</small>
                        </div>
                    </div>

                    {# Prediction du resultat #}
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="small text-muted">Prediction resultat</span>
                            <span class="badge {% if prediction.prediction == '1' %}bg-primary{% elseif prediction.prediction == 'X' %}bg-warning text-dark{% else %}bg-danger{% endif %}">
                                {% if prediction.prediction == '1' %}Victoire Dom.
                                {% elseif prediction.prediction == 'X' %}Match nul (OT)
                                {% else %}Victoire Ext.{% endif %}
                            </span>
                        </div>
                        <div class="row g-1 text-center">
                            <div class="col-4">
                                <div class="p-2 rounded {% if prediction.prediction == '1' %}bg-primary{% else %}bg-secondary bg-opacity-25{% endif %}">
                                    <div class="small text-muted">1</div>
                                    <div class="fw-bold">{{ prediction.probabilities['1'] }}%</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded {% if prediction.prediction == 'X' %}bg-warning text-dark{% else %}bg-secondary bg-opacity-25{% endif %}">
                                    <div class="small text-muted">X</div>
                                    <div class="fw-bold">{{ prediction.probabilities['X'] }}%</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded {% if prediction.prediction == '2' %}bg-danger{% else %}bg-secondary bg-opacity-25{% endif %}">
                                    <div class="small text-muted">2</div>
                                    <div class="fw-bold">{{ prediction.probabilities['2'] }}%</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Total de buts #}
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small text-muted">Total buts attendu</span>
                            <span class="badge bg-info">{{ total_goals.expected_total }} buts</span>
                        </div>
                        <div class="row g-1">
                            <div class="col-6">
                                <div class="p-2 rounded bg-success bg-opacity-25 text-center">
                                    <small class="text-muted">Over 5.5</small>
                                    <div class="fw-bold text-success">{{ total_goals.predictions['over_5.5']|round(0) }}%</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-2 rounded bg-danger bg-opacity-25 text-center">
                                    <small class="text-muted">Under 5.5</small>
                                    <div class="fw-bold text-danger">{{ total_goals.predictions['under_5.5']|round(0) }}%</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# Confiance #}
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="small text-muted">Confiance</span>
                            <span class="small fw-bold">{{ prediction.confidence }}%</span>
                        </div>
                        <div class="progress" style="height: 6px;">
                            <div class="progress-bar {% if prediction.confidence >= 70 %}bg-success{% elseif prediction.confidence >= 50 %}bg-warning{% else %}bg-danger{% endif %}"
                                 style="width: {{ prediction.confidence }}%"></div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-secondary">
                    <a href="{{ path('app_hockey_match_analysis', {'id': match.id}) }}" class="btn btn-outline-info btn-sm w-100">
                        <i class="fas fa-chart-line me-2"></i>Analyse detaillee
                    </a>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% endif %}

    {# Section des matchs termines recents avec verification des predictions #}
    {% if recent_finished_matches is defined and recent_finished_matches|length > 0 %}
    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-info">
                <div class="card-header bg-dark text-info d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="fas fa-history me-2"></i>Historique des Predictions
                    </h5>
                    <a href="{{ path('app_hockey_daily') }}" class="btn btn-sm btn-outline-info">
                        Voir tout <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>

                {# Statistiques de precision #}
                {% if accuracy_stats is defined and accuracy_stats.total_finished > 0 %}
                <div class="card-body border-bottom">
                    <div class="row text-center">
                        <div class="col-md-6 mb-2 mb-md-0">
                            <div class="h4 mb-0 {% if accuracy_stats.accuracy_rate >= 60 %}text-success{% elseif accuracy_stats.accuracy_rate >= 45 %}text-warning{% else %}text-danger{% endif %}">
                                {{ accuracy_stats.accuracy_rate }}%
                            </div>
                            <small class="text-muted">Precision des Predictions</small>
                        </div>
                        <div class="col-md-6">
                            <div class="h4 mb-0 text-info">{{ accuracy_stats.total_finished }}</div>
                            <small class="text-muted">Matchs Analyses</small>
                        </div>
                    </div>
                </div>
                {% endif %}

                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-secondary">
                                <tr>
                                    <th>Match</th>
                                    <th class="text-center">Score Final</th>
                                    <th class="text-center">Notre Prediction</th>
                                    <th class="text-center">Resultat</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for data in recent_finished_matches %}
                                <tr>
                                    <td>
                                        <a href="{{ path('app_hockey_match_analysis', {id: data.match.id}) }}" class="text-decoration-none">
                                            <strong>{{ data.match.homeTeam.name }}</strong>
                                            <span class="text-muted">vs</span>
                                            <strong>{{ data.match.awayTeam.name }}</strong>
                                        </a>
                                        <br>
                                        <small class="text-muted">{{ data.match.league }} - {{ data.match.matchDate|date('d/m H:i') }}</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-dark fs-6">{{ data.home_score }} - {{ data.away_score }}</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge {% if data.predicted_winner == 'home' %}bg-primary{% else %}bg-danger{% endif %}">
                                            {% if data.predicted_winner == 'home' %}{{ data.match.homeTeam.name }}{% else %}{{ data.match.awayTeam.name }}{% endif %}
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        {% if data.prediction_correct %}
                                            <span class="badge bg-success"><i class="fas fa-check"></i> Correct</span>
                                        {% else %}
                                            <span class="badge bg-danger"><i class="fas fa-times"></i> Incorrect</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}
</div>

<style>
.hover-card {
    transition: transform 0.2s, box-shadow 0.2s;
}
.hover-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0.5rem 1rem rgba(13, 202, 240, 0.15);
}
</style>
{% endblock %}
